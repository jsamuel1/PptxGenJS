{
	"name": "@jsamuel1/pptxgenjs",
	"version": "4.3.17",
	"author": {
		"name": "Joshua Samuel",
		"url": "https://github.com/jsamuel1/"
	},
	"contributors": [
		{
			"name": "Brent Ely",
			"url": "https://github.com/gitbrent/"
		}
	],
	"description": "Create JavaScript PowerPoint Presentations — fork with slide transitions, entrance animations, gradient fills, and 20+ OOXML correctness fixes",
	"homepage": "https://github.com/jsamuel1/PptxGenJS#readme",
	"license": "MIT",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/pptxgen.es.js",
			"require": "./dist/pptxgen.cjs.js"
		},
		"./utils": {
			"types": "./types/utils.d.ts",
			"import": "./dist/utils.es.js",
			"require": "./dist/utils.cjs.js"
		},
		"./icons-fa": {
			"types": "./types/icons-fa.d.ts",
			"import": "./dist/icons-fa.es.js",
			"require": "./dist/icons-fa.cjs.js"
		}
	},
	"main": "dist/pptxgen.cjs.js",
	"module": "dist/pptxgen.es.js",
	"sideEffects": false,
	"files": [
		"dist",
		"types"
	],
	"types": "types",
	"scripts": {
		"build": "rollup -c",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"ship": "SHIP=1 rollup -c && node tools/build/copy-demo-artifacts.mjs",
		"prepublishOnly": "SHIP=1 rollup -c",
		"watch": "rollup -cw",
		"pretest": "npm run build",
		"test": "node test/run.js && node test/run-schema.js",
		"schema-test": "node test/run-schema.js",
		"check-validator": "node tools/ooxml-validator/check-updates.js",
		"release-test": "npm test && node test/release/_runner.js",
		"test:ppt": "npm run build && node test/release/powerpoint.test.js"
	},
	"browser": {
		"express": false,
		"fs": false,
		"node:fs": false,
		"node:https": false,
		"os": false,
		"path": false
	},
	"dependencies": {
		"jszip": "^3.10.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fortawesome/fontawesome-free": "^7.2.0",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^25.9.2",
		"@typescript-eslint/eslint-plugin": "^8.60.1",
		"@typescript-eslint/parser": "^8.60.1",
		"eslint": "^10.4.1",
		"express": "^5.2.1",
		"js-yaml": "^4.2.0",
		"playwright": "^1.60.0",
		"rollup": "^4.61.1",
		"rollup-plugin-typescript2": "^0.37.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jsamuel1/PptxGenJS.git"
	},
	"keywords": [
		"fork",
		"pptx-animations",
		"es6-powerpoint",
		"html-to-powerpoint",
		"javascript-create-powerpoint",
		"javascript-create-pptx",
		"javascript-generate-pptx",
		"javascript-powerpoint",
		"javascript-powerpoint-charts",
		"javascript-pptx",
		"js-create-powerpoint",
		"js-create-pptx",
		"js-generate-powerpoint",
		"js-powerpoint",
		"js-powerpoint-library",
		"js-powerpoint-pptx",
		"node-powerpoint",
		"officejs-alternative",
		"react-powerpoint",
		"slide-generator",
		"typescript-powerpoint"
	],
	"bugs": {
		"url": "https://github.com/jsamuel1/PptxGenJS/issues"
	}
}
